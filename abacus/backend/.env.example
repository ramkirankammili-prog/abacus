# Backend configuration. Copy to .env. Never commit or share the .env file.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Required: use your Supabase project URL (not the /rest/v1 URL) and publishable/public key.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLIC_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Optional AI explanations.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional external pre-decision checks. Keys are used only by the backend.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
# Optional endpoint returning JSON such as {"blocked": false, "reason": "No restrictions found"}.
ROAD_RESTRICTIONS_API_URL=

# Road distance / travel-time estimates. Public OSRM is not live traffic.
OSRM_URL=https://router.project-osrm.org
OSRM_ENABLED=true
OSRM_TIMEOUT=6

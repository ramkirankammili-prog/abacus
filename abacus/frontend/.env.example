# Frontend configuration. Copy to .env (never commit .env).
VITE_API_URL=http://127.0.0.1:8000

# Needed only by Supabase Auth (sign in / sign up). The public/publishable key is designed to be
# visible to browsers and is protected by Row Level Security. Never put a secret/service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLIC_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Do not add Gemini, Google Maps, or OpenWeather private API keys here. Keep them in backend/.env.
